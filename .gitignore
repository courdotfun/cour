# Foundry
cache/
out/
broadcast/
!broadcast/**/dry-run/

# Dependencies (reproduce with ./bootstrap.sh)
lib/
# ...but the Next app's source lib/ (app/lib) is real source, not foundry deps
!/app/lib/

# Env & secrets
.env
.env.*
!.env.example

# Node
node_modules/

# Misc
*.log
.DS_Store
coverage/
lcov.info

# Deploy outputs: keep the dir (.gitkeep) but not fork/anvil run artifacts.
# The real mainnet deployments/4663.json is force-added after the mainnet deploy.
deployments/*.json
docs/_*.log

# x-ray skill working dir (consolidated into docs/audit/)
x-ray/

# medusa fuzz corpus/coverage (regenerated by the campaign)
fizz_data/

# crytic-compile export (regenerated)
crytic-export/
script/safe/out/

# parity diff PNGs + raw captures are regenerated by parity.mjs; keep the report, not the images
docs/visual-diff/parity/
docs/visual-diff/raw/

# parity Stop-hook block counter (local)
.claude/hooks/.count
