# ---- COUR monitor configuration ----
# Copy to monitor/.env and fill in. NEVER commit a real .env (gitignored).

# REQUIRED: JSON-RPC endpoint for Robinhood Chain (chainId 4663).
# In the repo this is the value of RH_RPC_URL in the top-level .env.
MONITOR_RPC_URL=

# OPTIONAL: override which deployment file to load (addresses + startBlock).
# Default: ../deployments/4663.json (resolved relative to the monitor/ dir).
# DEPLOYMENT_FILE=/abs/path/to/deployments/4663.json

# ---- Alerting (Telegram). If unset, alerts go to console only. ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Suppress identical alerts re-seen within this many ms (default 300000 = 5 min).
# ALERT_DEDUPE_MS=300000

# ---- Polling / health loop ----
# POLL_INTERVAL_MS=12000        # event watch + block polling cadence
# HEALTH_INTERVAL_MS=60000      # periodic read loop cadence
# DEPLOYER_MIN_ETH=0.05         # alert if deployer ETH balance drops below this
# STOCK_DEVIATION_PCT=10        # alert if stockUsd(NVDA) moves >= this % between reads
# LARGE_FEE_STOCK=1000          # alert on FeeTaken whose stockFee (whole units) >= this

# ---- HTTP status server ----
# HTTP_HOST=127.0.0.1
# HTTP_PORT=8080
