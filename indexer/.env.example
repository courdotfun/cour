# --- COUR indexer environment ---------------------------------------------

# RPC endpoint for COUR chain (chainId 4663 "Robinhood Chain").
# Ponder maps PONDER_RPC_URL_<chainId> to the chain automatically.
# Locally you can pull it from the repo .env:
#   export PONDER_RPC_URL_4663="$(grep '^RH_RPC_URL=' ../.env | cut -d= -f2-)"
PONDER_RPC_URL_4663=

# Postgres connection string (prod). Omit to use the bundled pglite dev store.
# docker-compose provides this automatically.
DATABASE_URL=

# Optional: schema/namespace for multiple deployments against one database.
# DATABASE_SCHEMA=public

# Port for the HTTP server (GraphQL + REST). Default 42069.
# PORT=42069
