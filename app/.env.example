# ---- COUR app env ----
# Public (exposed to the browser — NEVER secrets)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_WC_PROJECT_ID=
# optional: override the same-origin indexer proxy base (default /api/ix)
# NEXT_PUBLIC_INDEXER_PROXY=/api/ix

# Server-only (set in Vercel Project Settings, never prefixed NEXT_PUBLIC_)
# Ponder indexer base URL (default = Railway deployment)
INDEXER_URL=https://indexer-production-f5ef70d7.up.railway.app
# Pinata JWT for IPFS uploads (/api/upload)
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Postgres for off-chain app data (profiles/follows/updates/sessions). Uses schema "app".
APP_DATABASE_URL=postgres://user:pass@host:5432/db
# 32+ byte random string for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=
# RPC used by server route handlers (safe-tx nonce, creator checks). Falls back to NEXT_PUBLIC_RPC_URL.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
