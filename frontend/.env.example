# ---- COUR frontend environment ----
# Copy to .env.local (gitignored) and fill in. NEVER commit real secrets.

# Robinhood Chain RPC (chainId 4663). Public example shown; use your own for prod.
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Indexer REST/GraphQL base URL (the `indexer/` Ponder app). No trailing slash.
# When unset the app falls back to direct on-chain reads where possible and
# shows honest empty/error states elsewhere.
VITE_INDEXER_URL=http://localhost:42069

# WalletConnect / Reown project id. When set, a "WalletConnect" option appears in
# the connect modal (QR / mobile wallets) alongside EIP-6963 injected wallets.
# Add cour.fun + www.cour.fun to the project's allowed domains in the Reown dashboard.
VITE_WC_PROJECT_ID=

# IPFS image/metadata upload is SERVER-SIDE ONLY. The Pinata JWT is configured as
# a server env var in Vercel (name: PINATA_JWT, WITHOUT the VITE_ prefix) so it is
# never bundled into the client. See frontend/api/upload.ts. Do NOT add VITE_PINATA_JWT.
# PINATA_JWT=            # set in Vercel project env (server), not here
# PINATA_GATEWAY=        # optional, gateway base for returned URLs
