# ---- COUR Phase 1 environment ----
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# RPC endpoints
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com        # Robinhood Chain mainnet (chainId 4663)
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com # chainId 46630

# Deployer / admin
DEPLOYER_PK=                     # deployer private key (hex, 0x-prefixed). Used only with --broadcast. Create with `cast wallet new`.
DEPLOYER_ADDRESS=                # public address of DEPLOYER_PK
TREASURY=                        # platform treasury address (receives 20% platform fees); defaults to DEPLOYER_ADDRESS for tests
MULTISIG=                        # Safe multisig address; becomes Timelock proposer/executor (not used for the test deploy)

# Verification
ETHERSCAN_API_KEY=               # robin.etherscan.io (Etherscan API v2, chainid=4663)
BLOCKSCOUT_API_KEY=              # optional; Blockscout verify API key
