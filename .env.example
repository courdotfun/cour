# ---- COUR Phase 1 environment ----
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# RPC endpoints
RH_RPC_URL=                      # Robinhood Chain mainnet RPC (chainId 4663)
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com   # chainId 46630

# Deployer / admin
DEPLOYER_PK=                     # deployer private key (hex, 0x-prefixed). Used only with --broadcast.
TREASURY=                        # platform treasury address (receives 20% platform fees)
MULTISIG=                        # Safe multisig address; becomes Timelock proposer/executor

# Verification
BLOCKSCOUT_API_KEY=              # optional; Blockscout verify API key
